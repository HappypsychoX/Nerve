# Nerve — environment configuration
#
# Copy this file to `.env` and adjust for your environment.
# Secrets and connection details live here, never in config/*.yaml.

# Port Nerve binds to inside the container.
PORT=3000

# Optional display overrides (otherwise taken from config YAML).
# NERVE_TITLE=Nerve
# NERVE_SERVER_NAME=Home Server

# Optional: alternate config file path (defaults to config/nerve.yaml).
# NERVE_CONFIG_PATH=/app/config/nerve.yaml

# --- Integration connection details ---
# Defaults to the compose-provided socket proxy. Override to point Nerve at a
# different Docker host (tcp:// or http:// schemes are supported).
DOCKER_HOST=tcp://socket-proxy:2375
# WUD — What's up Docker? update registry (read-only).
# WUD_URL=http://wud:3000
# WUD_USERNAME=
# WUD_PASSWORD=
# Gluetun — VPN control server (read-only). Requires a role-scoped API key
# (sent as X-API-Key) granting GET /v1/vpn/status and GET /v1/publicip/ip only.
# Generate the key with: docker run --rm qmcgaw/gluetun genkey
GLUETUN_URL=http://gluetun:8000
GLUETUN_API_KEY=
OFFEN_WEBHOOK_TOKEN=

# Where Nerve persists its SQLite database (backup run history).
# NERVE_DATABASE_PATH=/app/data/nerve.db
